# Matchids — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# Every value below is a placeholder / integration point — no live credentials exist in this repository.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database ---
# Any Postgres-compatible connection string (Supabase, Neon, RDS, local, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/matchids"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_SESSION_COOKIE_NAME=matchids_session

# --- Traditional payments (card processor) ---
# Matchids' payment layer is provider-agnostic (see src/lib/payments).
# Fill in whichever processor is actually connected. Example keys shown for Stripe,
# swap for the processor you choose — see src/lib/payments/providers.
PAYMENT_PROVIDER_CARD=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CeloHT (Web3 payment provider) ---
# CeloHT is a dapp that lets people send and receive CELO and USDm on the Celo blockchain.
# These values are integration points only. Do NOT invent contract addresses, RPC endpoints,
# or API keys — leave blank until CeloHT provides real values, and the app will report the
# provider as "not configured" rather than pretending a payment succeeded.
CELOHT_API_BASE_URL=
CELOHT_API_KEY=
CELOHT_NETWORK=celo-mainnet
CELOHT_WEBHOOK_SECRET=

# --- Give Back / donations ---
DONATIONS_DEFAULT_CURRENCY=USD

# --- Email (transactional) ---
EMAIL_FROM_ADDRESS=hello@matchids.org
EMAIL_PROVIDER_API_KEY=

# --- File storage (book PDFs, cover images, kids-art uploads) ---
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Admin bootstrap (development only, remove in production) ---
ADMIN_BOOTSTRAP_EMAIL=
