# Matchids — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# No live credentials are included in this repository.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database ---
# Set this to a local or hosted PostgreSQL database.
DATABASE_URL="postgresql://user:password@localhost:5432/matchids"

# --- Auth ---
# Generate with: openssl rand -base64 32 (must be at least 32 characters)
AUTH_SECRET=
AUTH_SESSION_COOKIE_NAME=matchids_session

# --- Traditional payments (card processor) ---
# No card processor is currently integrated; keys alone do not enable payments.
PAYMENT_PROVIDER_CARD=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CeloHT (Web3 payment provider) ---
# Do not invent endpoints, network settings, or credentials. The provider remains
# unavailable until its real API and server-side verification flow are implemented.
CELOHT_API_BASE_URL=
CELOHT_API_KEY=
CELOHT_NETWORK=
CELOHT_WEBHOOK_SECRET=

# --- Give Back / donations ---
DONATIONS_DEFAULT_CURRENCY=USD

# --- Contact form and SMTP notifications ---
MATCHIDS_CONTACT_EMAIL=matchids911@gmail.com
CONTACT_RATE_LIMIT_SECRET=
# Configure only when the production proxy overwrites this header.
CONTACT_TRUSTED_IP_HEADER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# --- File storage (book PDFs, cover images, kids-art uploads) ---
# Uploads are disabled until private storage and signed-upload flows exist.
STORAGE_PROVIDER=unconfigured
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=